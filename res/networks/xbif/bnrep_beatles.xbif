<?xml version='1.0' encoding='utf-8'?>
<BIF VERSION="0.3">
  <NETWORK>
    <NAME>unknown</NAME>
    <VARIABLE TYPE="nature">
      <NAME>ExactlyOneBeatlesIsDead</NAME>
      <OUTCOME>TRUE</OUTCOME>
      <OUTCOME>FALSE</OUTCOME>
      <PROPERTY>weight = None</PROPERTY>
    </VARIABLE>
    <VARIABLE TYPE="nature">
      <NAME>GeorgeIsAlive</NAME>
      <OUTCOME>TRUE</OUTCOME>
      <OUTCOME>FALSE</OUTCOME>
      <PROPERTY>weight = None</PROPERTY>
    </VARIABLE>
    <VARIABLE TYPE="nature">
      <NAME>JohnIsAlive</NAME>
      <OUTCOME>TRUE</OUTCOME>
      <OUTCOME>FALSE</OUTCOME>
      <PROPERTY>weight = None</PROPERTY>
    </VARIABLE>
    <VARIABLE TYPE="nature">
      <NAME>PaulIsAlive</NAME>
      <OUTCOME>TRUE</OUTCOME>
      <OUTCOME>FALSE</OUTCOME>
      <PROPERTY>weight = None</PROPERTY>
    </VARIABLE>
    <VARIABLE TYPE="nature">
