network unknown {
}
variable ASTTest {
  type discrete [ 2 ] { Initiated, Not_initiated };
}
variable ClinicianExperience {
  type discrete [ 2 ] { Experienced, Unexperienced };
}
variable EpidemiologicalFactors {
  type discrete [ 2 ] { High_Risk_Group, Low_Risk_Group };
}
variable InitialTreatmentFailure {
  type discrete [ 2 ] { Treatment_success, Treatment_failure };
}
variable MedicationAdherence {
  type discrete [ 2 ] { Proper_Adherence, Improper_Adherence };
}
variable NumberPartners {
  type discrete [ 3 ] { One, Two_to_five, More_than_six };
}
variable PastDiagnoses {
  type discrete [ 4 ] { One, Two_to_four, Five_to_nine, More_than_ten };
}
variable PersistingSymptoms {
  type discrete [ 2 ] { Symptoms_persist, Symptoms_resolve };
}
variable SexualOrientation {
  type discrete [ 2 ] { Heterosexual, Homosexual };
}
variable UnpromptedTest {
  type discrete [ 2 ] { Initiated, Not_initiated };
}
probability ( ASTTest | InitialTreatmentFailure, UnpromptedTest ) {
  (Treatment_success, Initiated) 0.99, 0.01;
  (Treatment_failure, Initiated) 0.99, 0.01;
  (Treatment_success, Not_initiated) 0.01, 0.99;
  (Treatment_failure, Not_initiated) 0.9, 0.1;
}
