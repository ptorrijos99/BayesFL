network unknown {
}
variable AcuteToxicityDermalExposure {
  type discrete [ 6 ] { Less_than_50, 50_200, 200_1000, 1000_2000, 2000_5000, No_effect };
}
variable AcuteToxicityExposureByDustInhalation {
  type discrete [ 5 ] { Less_than_0_5, 0_5_2, 2_10, 10_20, No_effect };
}
variable AcuteToxicityExposureByGasInhalation {
  type discrete [ 5 ] { Less_than_100, 100_500, 500_2500, 2500_20000, No_effect };
}
variable AdministrativeMeasures {
  type discrete [ 3 ] { High, Medium, Low };
}
variable AerosolFormation {
  type discrete [ 2 ] { With, Without };
}
variable Agglomeration {
  type discrete [ 2 ] { With, Without };
}
variable Amount {
  type discrete [ 3 ] { _10mg, 10_100mg, _100mg };
}
variable BodyProtection {
  type discrete [ 4 ] { No_use, Cotton_lab_coats, Synthetic_material_lab_coats, Chemical_protection_coveralls };
}
variable ChronicToxicityByTheExposureRouteInhalationDust {
  type discrete [ 5 ] { Less_than_0_5, 0_5_2, 2_10, 10_20, No_effect };
}
variable ChronicToxicityByTheExposureRouteInhalationGas {
  type discrete [ 3 ] { Less_than_50, 50_200, No_effect };
}
variable ChronicToxicityDermalExposure {
  type discrete [ 3 ] { Less_than_20, 20_200, No_effect };
}
variable ChronicToxicityExposureByDustInhalation {
  type discrete [ 3 ] { Less_than_0_02, 0_02_0_2, No_effect };
}
variable ChronicToxicityInTheAquaticEnvironment {
  type discrete [ 4 ] { Less_than_0_01, 0_01_0_1, 0_1_1, No_effect };
}
variable ClassificationGHS {
  type discrete [ 5 ] { 1, 2, 3, 4, 5 };
}
variable CrystallineStructure {
  type discrete [ 2 ] { With, Without };
}
variable Duration {
  type discrete [ 3 ] { _30min, 30_240min, _240min };
}
variable DustFormation {
  type discrete [ 2 ] { With, Without };
}
variable Exposure {
  type discrete [ 3 ] { High, Medium, Low };
}
variable EyeIrritation {
  type discrete [ 3 ] { No_effect, Reversible_irritation, Irreversible_damage };
}
variable EyesProtection {
  type discrete [ 4 ] { No_use, Safety_glasses, Safety_goggles, Face_shields };
}
variable FootProtection {
  type discrete [ 3 ] { Open_shoes, Work_shoes, Safety_shoes_for_chemical_agents };
}
variable Frequency {
  type discrete [ 5 ] { Daily, Weekly, Monthly, Semiannual, Yearly };
}
variable HandProtection {
  type discrete [ 4 ] { No_use, Rubber_gloves, Nitrile_gloves___1_pair, Nitrile_gloves___2_pairs };
}
variable Hazard {
  type discrete [ 3 ] { High, Medium, Low };
}
variable MedicalSurveillance {
  type discrete [ 3 ] { No, Yes, Yes__consider_NMs };
}
variable Morphology {
  type discrete [ 3 ] { Spherical, Plates, Rods };
}
variable OccupationalEnvironmentRiskProgram {
  type discrete [ 3 ] { No, Yes, Yes__consider_NMs };
}
variable PeriodicMaintenanceOfCPE {
  type discrete [ 3 ] { No, Yes__less_than_12_months, Yes__more_than_12_months };
}
variable PersonalProtectiveEquipment {
  type discrete [ 3 ] { High, Medium, Low };
}
variable PotentiallyCarcinogenic {
  type discrete [ 3 ] { Confirmed_for_humans, Possibly_toxic_to_humans, No_effect };
}
variable ProtectionByUsingCollectiveProtectiveEquipment {
  type discrete [ 4 ] { Full_containment_isolation, Enclosed_ventilation, Local_ventilation, General_mechanical_ventilation };
}
variable RespiratoryProtection {
  type discrete [ 3 ] { No_use, Safety_mask_without_selection_criteria, Respiratory_mask_according_to_the_respiratory_protection_program };
}
variable RespiratoryProtectionProgram {
  type discrete [ 3 ] { No, Yes, Yes__consider_NMs };
}
variable RespiratorySensitization {
  type discrete [ 3 ] { There_is_evidence_for_humans, There_are_positive_tests_for_animal_testing, No_effect };
}
variable Risk {
  type discrete [ 3 ] { High, Medium, Low };
}
variable RiskControl {
  type discrete [ 3 ] { High, Medium, Low };
}
variable RiskTrainingInvolvingNMs {
  type discrete [ 2 ] { No, Yes };
}
variable SizeOfAtLeastOneDimension {
  type discrete [ 2 ] { Less_than_100, More_than_100 };
}
variable SkinIrritation {
  type discrete [ 4 ] { Skin_corrosion, Skin_irritation, ILskin_irritation, No_effect };
}
variable SolubilityInWater {
  type discrete [ 2 ] { Dissolution_pH_5_to_9, Insoluble };
}
variable StandardOperatingProcedureOfTask {
  type discrete [ 2 ] { No, Yes };
}
variable SurfaceArea {
  type discrete [ 3 ] { __10_m2g, 10_49_m2g, _50_m2g };
}
variable SurfaceChargeInSolution {
  type discrete [ 2 ] { Charged, Neutral };
}
variable SurfaceModificationWithHydrophilicGroups {
  type discrete [ 2 ] { Without, With };
}
variable SuspensionStability {
  type discrete [ 2 ] { Less_than_30, More_than_30 };
}
variable VariablesPhysicoChemical {
  type discrete [ 3 ] { High, Medium, Low };
}
